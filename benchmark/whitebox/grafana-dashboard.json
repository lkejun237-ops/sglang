{
  "title": "Whitebox playtest service",
  "uid": "whitebox-playtest",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": [
    "whitebox",
    "mock"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "cluster_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(world_model_critical_path_stage_duration_seconds_count, cluster_id)"
      },
      {
        "name": "service_id",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(world_model_critical_path_stage_duration_seconds_count{cluster_id=~\"$cluster_id\"}, service_id)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Stage p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(world_model_critical_path_stage_duration_seconds_bucket{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage samples / second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(world_model_critical_path_stage_duration_seconds_count{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stage errors / second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(world_model_critical_path_stage_duration_seconds_count{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\",result=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Coordinator worker selection p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(world_model_coordinator_worker_selection_duration_seconds_bucket{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker reservation p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,worker_role) (rate(world_model_coordinator_capacity_reservation_duration_seconds_bucket{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Process resident memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{cluster_id=~\"$cluster_id\",service_id=~\"$service_id\"}",
          "legendFormat": "{{stage}} {{worker_role}} {{pod}}"
        }
      ]
    }
  ]
}
