# One role per container; build docker/whitebox.Dockerfile from white_box.
# Shared image does not include a model, GPU runtime, or credentials.
WHITEBOX_ROLE=gateway
SGLANG_LIGHTWEIGHT_RUNTIME=1
WORLD_MODEL_METRIC_MODEL=zing_h3
OTEL_SERVICE_NAME=whitebox-gateway
COORDINATOR_URL=http://whitebox-coordinator:18081
WHITEBOX_ENABLED=1
WHITEBOX_ENGINE_FACTORY=sglang.multimodal_gen.runtime.realtime.whitebox.browser_engine:factory
WHITEBOX_UI_FACTORY=sglang.multimodal_gen.runtime.realtime.whitebox.browser_engine:ui_factory
WHITEBOX_MODEL_METADATA={"mode":"mock_passthrough","training_eligible":false}
WHITEBOX_SPOOL=/var/lib/sglang/whitebox
WHITEBOX_WIDTH=832
WHITEBOX_HEIGHT=480
WHITEBOX_PLAY_SECONDS=60
WHITEBOX_STARTUP_SECONDS=90
WHITEBOX_DRAIN_SECONDS=30
WHITEBOX_PENDING_FRAMES=16
WHITEBOX_BROWSER_ORIGIN=https://world-test-platform.loopit.com.cn
WHITEBOX_OSS_BUCKET=world-model-test-platform
WHITEBOX_OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
WHITEBOX_OSS_REGION=cn-beijing
WHITEBOX_OSS_PREFIX=whitebox-playtest/mock-v1
# Inject AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY using the existing platform's
# ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET storage credential.
# Do not use the platform's unrelated AWS account credentials.

# Coordinator role only: WHITEBOX_ROLE=coordinator
REDIS_HOST=r-2ze358d0dce684b4.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_USERNAME=default
WHITEBOX_REDIS_PREFIX=whitebox-playtest-v1
# Inject REDIS_PASSWORD at deployment; never commit its value.
WHITEBOX_SLOTS=2

# Mock worker role only: WHITEBOX_ROLE=mock-worker, exactly one replica.
PORT=18089
WORKER_URL=http://whitebox-mock-worker:18089

# Existing test platform API role only (do not update scheduler/runner/accounts):
# WORLD_TEST_WHITEBOX_GATEWAY_URL=wss://APPROVED_GATEWAY/v1/realtime_video/generate
# WORLD_TEST_WHITEBOX_SOURCE_MODE=browser_mock
