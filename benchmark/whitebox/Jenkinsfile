    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        AWS_ACCOUNT_ID = '829115578968'
        AWS_REGION = 'us-east-2'
        ECR_REGISTRY = '829115578968.dkr.ecr.us-east-2.amazonaws.com'
        ECR_REPOSITORY = 'leap-world/minwm-realtime'
        IMAGE_REPOSITORY = '829115578968.dkr.ecr.us-east-2.amazonaws.com/leap-world/minwm-realtime'
        ECR_IMAGE_REPOSITORY = '829115578968.dkr.ecr.us-east-2.amazonaws.com/leap-world/minwm-realtime'
        PYTHON_BASE_IMAGE = 'public.ecr.aws/docker/library/python@sha256:d657ab0ade19f404a6ccc883ab399540de667aff751748ce23c07330c5a89e64'
        GPU_BASE_IMAGE = '829115578968.dkr.ecr.us-east-2.amazonaws.com/leap-world/minwm-runtime@sha256:3fc2bb1e8aef10c53160c13ce00490ce48ed3be812f9c05da9d51a27da0be1b4'
