                sh '''
git config --global filter.lfs.smudge "git-lfs smudge --skip -- %f"
git config --global filter.lfs.process "git-lfs filter-process --skip"
git config --global filter.lfs.required false
'''
                script {
                    String branch = params.BRANCH_NAME?.trim() ?: ''
                    String commitSha = platformCommitSha()
                    if (!branch) {
                        error('World Model CI 构建分支不能为空。')
                    }
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: commitSha ?: "*/${branch}"]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout'],
                            [$class: 'CloneOption', noTags: true, shallow: !commitSha, depth: 1]
                        ],
                        userRemoteConfigs: [[
                            url: worldModelBuildSpec().gitRepo,
                            credentialsId: 'github-ssh-key'
                        ]]
                    ])
                    verifyPlatformSourceRevision(branch, commitSha)
                    prepareWorldModelBuild()
                }
            }
        }

        stage('Pinned CLI SDK') {
            when { expression { env.BUILD_TARGET == 'room' } }
            steps {
                script {
                    String sdkSha = readFile('benchmark/whitebox/sdk-revision.txt').trim()
                    if (!(sdkSha ==~ /[0-9a-f]{40}/)) { error('Invalid CLI SDK revision') }
                    dir('.whitebox-sdk') { deleteDir() }
                    dir('.whitebox-sdk-checkout') {
                        deleteDir()
                        try {
                            checkout([
                                $class: 'GitSCM', branches: [[name: sdkSha]],
                                extensions: [[$class: 'CleanBeforeCheckout']],
                                userRemoteConfigs: [[url: 'git@github.com:seedleap/agent-whitebox-world-sdk.git', credentialsId: 'github-ssh-key']]
                            ])
                            withEnv(["WHITEBOX_SDK_REVISION=${sdkSha}", "WHITEBOX_SOURCE_BRANCH=${params.BRANCH_NAME?.trim() ?: ''}"]) {
                                sh '''
set -eu
test "$(git rev-parse HEAD)" = "$WHITEBOX_SDK_REVISION"
# GitSCM fetched both shared branches using the scoped checkout credential.
# Validate locally; shell commands must not initiate an unauthenticated fetch.
git merge-base --is-ancestor "$WHITEBOX_SDK_REVISION" origin/dev
test -z "$(git status --porcelain)"
archive="$(mktemp)"
trap 'rm -f "$archive"' EXIT
sh ../deploy/whitebox/room-sdk-archive.sh . "$WHITEBOX_SDK_REVISION" > "$archive"
mkdir ../.whitebox-sdk
tar -xf "$archive" -C ../.whitebox-sdk
'''
                            }
                        } finally {
                            deleteDir()
                        }
                    }
                }
            }
        }

        stage('Platform Dockerfile') {
            steps {
                script {
                    downloadPlatformDockerfile(env.DOCKERFILE_PATH)
                    prepareWhiteboxCacheRecipe()
                }
            }
        }

        stage('Source and Build Contract') {
            steps {
                sh '''
set -eu
git diff --check
test -s "$DOCKERFILE_PATH"
if [ "$IMAGE_TAG_PREFIX" = whitebox-ui ]; then
  test -s server/whitebox-lane.mjs
  test -s pnpm-lock.yaml
else
  test -s benchmark/whitebox/requirements.txt
  test -s benchmark/whitebox/run_service.py
fi
# The release image depends on its checks stage: actual CPU tests run
# during BuildKit. No model, shared Redis, OSS writes or Kubernetes CD here.
'''
            }
        }

        stage('Registry Preflight') {
            steps {
                script {
                    prepareWorldModelEcr()
                    discoverWhiteboxCacheCandidates()
                    prepareDirectAcrProxy()
                    if (env.ACR_DIRECT_PUSH == 'true') { addAcrRegistryAuth(instanceId: env.ACR_INSTANCE_ID, registry: env.ACR_REGISTRY, region: env.ACR_REGION) }
                }
            }
        }

        stage('Build and Push Immutable Image') {
            when {
                expression { env.IMAGE_ALREADY_EXISTS != 'true' }
            }
            steps {
                container('buildkit') {
                    sh '''
set -eu
export DOCKER_CONFIG=/build-secrets/docker
export BUILDKITD_FLAGS=--oci-worker-no-process-sandbox
dockerfile_dir="$(dirname "$DOCKERFILE_PATH")"
dockerfile_name="$(basename "$DOCKERFILE_PATH")"
set -- buildctl-daemonless.sh build \
  --frontend dockerfile.v0 \
  --local context="$WORKSPACE" \
  --local dockerfile="$WORKSPACE/$dockerfile_dir" \
  --opt filename="$dockerfile_name" \
  --opt platform=linux/amd64 \
  --opt build-arg:PYTHON_IMAGE="$PYTHON_BASE_IMAGE" \
  --opt build-arg:GPU_IMAGE="$GPU_BASE_IMAGE" \
  --opt build-arg:SOURCE_REVISION="$GIT_SHA" \
  --opt label:org.opencontainers.image.revision="$GIT_SHA" \
  --progress plain
if [ -f benchmark/whitebox/sdk-revision.txt ]; then
  sdk_sha="$(cat benchmark/whitebox/sdk-revision.txt)"
  set -- "$@" --opt build-arg:WHITEBOX_SOURCE_SHA="$GIT_SHA" \
    --opt build-arg:WHITEBOX_SDK_SHA="$sdk_sha" \
    --opt build-arg:WHITEBOX_SOURCE_BRANCH="$WHITEBOX_SOURCE_BRANCH"
fi
if [ -n "$BUILD_TARGET" ]; then
  set -- "$@" --opt target="$BUILD_TARGET"
fi
if [ -n "${WHITEBOX_CACHE_RECIPE:-}" ]; then
  set -- "$@" \
    --opt label:org.worldkit.whitebox.cache.branch="$WHITEBOX_CACHE_BRANCH" \
    --opt label:org.worldkit.whitebox.cache.target="$BUILD_TARGET" \
    --opt label:org.worldkit.whitebox.cache.recipe-sha256="$WHITEBOX_CACHE_RECIPE"
fi
while IFS= read -r cache_ref; do
  if [ -n "$cache_ref" ]; then
    set -- "$@" --import-cache "type=registry,ref=$cache_ref"
  fi
done < /build-secrets/world-model-cache-imports
"$@" \
  --export-cache type=inline \
  --metadata-file /build-secrets/image-metadata.json \
  --output "$BUILDKIT_IMAGE_OUTPUT"
'''
                }
            }
        }

        stage('Reuse Immutable Image') {
            when {
                expression { env.IMAGE_ALREADY_EXISTS == 'true' }
            }
            steps {
                echo "immutable image 已存在；跳过重复 push：${env.IMAGE_REF}@${env.IMAGE_DIGEST}"
            }
        }

        stage('Resolve Registry Digest') {
            steps {
                script {
                    resolveWorldModelImageDigest()
                }
            }
        }

        stage('Verify Regional ACR Image') {
            when {
                expression { env.ACR_DIRECT_PUSH == 'true' }
            }
            steps {
                script {
                    waitForRegistryImageDigest(
                        registry: env.ACR_REGISTRY,
                        image: env.ACR_IMAGE_REF,
                        expectedDigest: env.IMAGE_DIGEST,
                        timeoutSeconds: 60,
                        sourceRevision: env.THAILAND_ACR_ONLY == 'true' ? env.GIT_SHA : '',
                    )
                }
            }
        }
    }

    post {
        success { script { callbackPlatform('SUCCESS') } }
        failure { script { callbackPlatform('FAILURE') } }
        aborted { script { callbackPlatform('ABORTED') } }
        unstable { script { callbackPlatform('UNSTABLE') } }
        // Callback consumes the verified artifact; cleanup runs after all outcomes.
        cleanup {
            container('aws') {
                sh label: '清理构建凭据', returnStatus: true, script: 'rm -rf /build-secrets/docker /build-secrets/world-model-cache-imports /build-secrets/image-metadata.json /build-secrets/verified-acr-image.json'
            }
        }
    }
}
